# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.pyc


# 忽略当前目录下的某个文件夹
.claude/
.idea/
# agent 记忆目录：含密钥/IP/设备序列号，不要提交
.workbuddy/
.stock/cache/
.stock/cache_sina/

# 忽略任意层级同名文件夹
**/node_modules/
**/dist/

# 忽略特定文件
*.log
*.env
*.apk
*.zip
*.img
*.mitm
*.pkl

# 二进制产物：体积大，且都能从本地 APK 重新提取/脱壳，不入库
**/*.so.*
*.so
*.dex
# IDA 数据库与分析中间文件（几十 MB，可重新分析生成）
*.i64
*.id0
*.id1
*.id2
*.nam
*.til
*.i64.bak

# ---- 逆向产物（本地保留，不提交）----
# 由 APK 脱壳/DEX 导出得到，可重跑工具链再生
mcd/resources/decorticate/
# 从 APK 提取的 .so 库集合
mcd/resources/so/
# APK 附带的 frida-gadget 等二进制
mcd/resources/apk/
# 大体积抓包/二进制落盘目录（保留 logs 里的文本证据）
mcd/resources/*.bin
